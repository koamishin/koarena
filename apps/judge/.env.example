# Local development. Gitignored — copy this file to .env.
#
# The worker shares the app's database and queue: a worker pointed at a
# different database fails every job with "submission does not exist".

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koarena"
DATABASE_POOL_MAX="5"
REDIS_URL="redis://localhost:6379"

# judge0 | local | simulated.
#   judge0    — submit to a Judge0 instance (production)
#   local     — really execute the program here; refuses to start unless
#               RUNNER_ALLOW_LOCAL_EXECUTION is set, and never in production
#   simulated — decide the verdict from a marker in the source, so the whole
#               pipeline runs without a sandbox
RUNNER_MODE="simulated"
JUDGE0_URL="http://localhost:2357"
JUDGE0_API_KEY=""
JUDGE_CONCURRENCY="4"
