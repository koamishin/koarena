# --- Database -------------------------------------------------------------
# Any Postgres works. Two shapes are supported.
#
# Managed Postgres, pooled TCP (recommended for serverless):
#   DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=verify-full"
#
# Local Docker Postgres (pnpm infra:up):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koarena"
#
# Use the pooled endpoint, not a direct one: serverless concurrency will exhaust
# direct connections. sslmode=verify-full checks the server certificate's
# hostname; require works but does not verify it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koarena"
# Unpooled URL, used by CI for migrations only.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/koarena"
DATABASE_POOL_MAX="10"

# --- Redis ---------------------------------------------------------------
# Classic Redis with blocking commands (BullMQ needs them). Not Upstash.
REDIS_URL="redis://localhost:6379"

# --- Clerk ---------------------------------------------------------------
# https://dashboard.clerk.com -> your app -> API keys
# The publishable key and the secret key must come from the SAME app.
CLERK_SECRET_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""

# --- Code execution (worker host) ---------------------------------------
JUDGE0_URL="http://localhost:2357"
JUDGE0_API_KEY=""

# --- Crypto --------------------------------------------------------------
# 32 bytes, base64. Generate with:  openssl rand -base64 32
# Rotating this key invalidates every stored flag.
FLAG_ENCRYPTION_KEY=""

# --- Storage -------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="koarena"
S3_ACCESS_KEY_ID="koarena"
S3_SECRET_ACCESS_KEY="koarena-secret"
S3_FORCE_PATH_STYLE="true"

# --- Email ---------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="KoArena <noreply@koarena.dev>"

# --- Observability -------------------------------------------------------
SENTRY_DSN=""
